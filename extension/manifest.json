{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": [
    "https://glados.cloud/*",
    "https://glados.rocks/*",
    "https://glados.network/*",
    "https://glados.space/*",
    "https://glados.one/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "content_scripts": [
    {
      "matches": [
        "https://glados.cloud/console/checkin*",
        "https://glados.rocks/console/checkin*",
        "https://glados.network/console/checkin*",
        "https://glados.space/console/checkin*",
        "https://glados.one/console/checkin*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
